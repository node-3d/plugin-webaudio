{
	"name": "@node-3d/plugin-webaudio",
	"version": "4.0.1",
	"description": "WebAudio plugin for Node3D",
	"keywords": [
		"3d",
		"audio",
		"graphics",
		"labsound",
		"node3d",
		"plugin",
		"sound",
		"webaudio"
	],
	"homepage": "https://github.com/node-3d/node-3d#readme",
	"bugs": {
		"url": "https://github.com/node-3d/node-3d/issues"
	},
	"license": "MIT",
	"author": "Luis Blanco <luisblanco1337@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/node-3d/plugin-webaudio.git"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md",
		"tsconfig.build.json"
	],
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"i": "npm install --workspaces=false",
		"test:watch": "node --test --watch \"test/**/*.test.ts\"",
		"test:ci": "node --test \"test/**/*.test.ts\"",
		"lint:oxlint": "oxlint .",
		"lint:all": "npm run lint:ts && npm run lint:oxlint",
		"build:ci": "rslib build",
		"build:watch": "rslib build --watch",
		"lint:ts": "tsc -p tsconfig.json --noEmit",
		"prepack": "npm run build:ci",
		"format:ts": "oxfmt -c ./oxfmt.config.ts --no-error-on-unmatched-pattern \"**/*.{js,jsx,ts,tsx}\"",
		"format:ts:ci": "oxfmt -c ./oxfmt.config.ts --check --no-error-on-unmatched-pattern \"**/*.{js,jsx,ts,tsx}\""
	},
	"dependencies": {
		"@node-3d/webaudio": "~6.0.0"
	},
	"devDependencies": {
		"@node-3d/addon-tools": "10.0.6",
		"@node-3d/core": "6.3.1",
		"@rslib/core": "1.0.0",
		"@types/node": "24.13.2",
		"@types/three": "0.185.4",
		"oxfmt": "0.66.0",
		"oxlint": "1.81.0",
		"oxlint-tsgolint": "7.0.2001",
		"three": "0.185.1",
		"tslib": "2.8.1",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=22.18.0",
		"npm": ">=10.9.0"
	}
}
